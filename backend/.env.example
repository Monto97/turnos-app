# ============================================================
#  Variables de entorno - Sistema de Turnos (PostgreSQL / Vercel)
# ============================================================

# --- Base de datos ---
# PostgreSQL connection string de Neon (https://neon.tech)
# Formato: postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=postgresql://neondb_owner:npg_MjIGEC1dqT7Q@ep-blue-bar-ac3g8eao-pooler.sa-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# --- Servidor ---
PORT=3000

# --- Autenticación ---
JWT_SECRET=cambiar_por_string_aleatorio_minimo_32_chars
# Código para registrarse como dueño del panel
CODIGO_DUENO=DUENO-2026

# --- URLs ---
# URL del frontend Angular en Vercel (para links en emails)
FRONTEND_URL=https://TU-PROYECTO-FRONTEND.vercel.app
# URL del backend en Vercel (para webhooks de MercadoPago)
BACKEND_URL=https://TU-PROYECTO-BACKEND.vercel.app

# --- CORS ---
# Orígenes permitidos (separados por coma)
# Incluir el frontend Angular Y la web de la pelu
CORS_ORIGIN=https://TU-PROYECTO-FRONTEND.vercel.app,https://TU-WEB-PELU.vercel.app

# --- Frame ancestors (para el <iframe> de la web de la pelu) ---
FRAME_ANCESTORS=https://TU-WEB-PELU.vercel.app https://TU-PROYECTO-FRONTEND.vercel.app

# --- Email (Resend) ---
# Dejá vacío para modo simulación (imprime los links en consola)
