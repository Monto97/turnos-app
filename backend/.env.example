# ============================================================
#  Variables de entorno - Sistema de Turnos
# ============================================================
#  Copiá este archivo como .env y ajustá los valores.
#  Para desarrollo local, estos valores coinciden con docker-compose.yml.
# ============================================================

# --- Base de datos ---
# Desarrollo local (docker-compose):
DB_HOST=localhost
DB_PORT=3306
DB_USER=turnos_user
DB_PASSWORD=turnos_pass_dev
DB_NAME=turnos

# Railway: el plugin MySQL provee estas variables automáticamente.
# En Railway no hace falta setear las DB_* de arriba: el sistema las lee
# de MYSQLHOST, MYSQLPORT, MYSQLUSER, MYSQLPASSWORD, MYSQLDATABASE.

# --- Servidor ---
PORT=3000

# --- Autenticación ---
# En producción usá una cadena larga y aleatoria (mínimo 32 chars).
# Generá una con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=dev_secreto_cambiar_en_produccion_1234567890

# URL del frontend (para armar links en emails).
# En producción = tu dominio de Railway (ej: https://mi-app.up.railway.app)
FRONTEND_URL=http://localhost:4200

# --- CORS ---
# Orígenes permitidos (separados por coma). Solo necesario para dev local.
# En producción el frontend corre en el mismo dominio que la API.
CORS_ORIGIN=http://localhost:4200

# --- Email (Resend) ---
# Dejá vacío para modo simulación (imprime los links en consola).
# Registrate gratis en resend.com y pegá tu API key acá.
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev

# --- Mercado Pago ---
# Dejá vacío para modo simulación (flujo de pago sin cobrar).
# Credentials de PRUEBA en mercadopago.com/developers
MP_ACCESS_TOKEN=
# URL pública del backend para los webhooks de MP.
# En producción = tu dominio de Railway (ej: https://mi-app.up.railway.app)
BACKEND_URL=http://localhost:3000

# --- Acceso de administrador ---
# Código para registrarse como dueño del panel.
# Cambialo por algo único antes de deployar.
CODIGO_DUENO=DUENO-2026
